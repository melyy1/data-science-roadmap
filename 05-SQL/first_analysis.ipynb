import sqlite3
import numpy as np
import pandas as pd

# 1. VERİTABANI VE TABLO OLUŞTURMA (SQL)
conn = sqlite3.connect(":memory:")
cursor = conn.cursor()

cursor.executescript(
    """
CREATE TABLE Calisanlar (
    ID INT PRIMARY KEY,
    AdSoyad VARCHAR(50),
    Departman VARCHAR(50),
    Maas INT,
    IseGirisYili INT,
    Durum VARCHAR(20) -- 'Aktif' veya 'Ayrildi'
);
"""
)

# Örnek İK Verileri
veriler = [
    (101, "Ahmet Yılmaz", "İnsan Kaynakları", 45000, 2021, "Aktif"),
    (102, "Ayşe Kaya", "İnsan Kaynakları", 95000, 2017, "Aktif"),
    (103, "Mehmet Demir", "İnsan Kaynakları", 32000, 2023, "Ayrildi"),
    (104, "Can Öztürk", "Yazılım", 110000, 2019, "Aktif"),
    (105, "Zeynep Çelik", "Yazılım", 75000, 2022, "Aktif"),
    (106, "Burak Arslan", "Yazılım", 65000, 2021, "Ayrildi"),
    (107, "Elif Yıldız", "Pazarlama", 85000, 2018, "Aktif"),
    (108, "Seda Aksoy", "Pazarlama", 40000, 2023, "Ayrildi"),
]

cursor.executemany("INSERT INTO Calisanlar VALUES (?, ?, ?, ?, ?, ?)", veriler)
conn.commit()

# 2. SQL İLE VERİYİ PANDAS DATAFRAME'İNE ÇEKME
df = pd.read_sql_query("SELECT * FROM Calisanlar", conn)
conn.close()

# 3. NUMPY İLE KIDEM (KAÇ YILDIR ŞİRKETTE) HESAPLAMA
mevcut_yil = 2026
df["Kidem_Yili"] = np.subtract(mevcut_yil, df["IseGirisYili"].values)

# 4. PANDAS İLE İK ÖZET TABLOSU
ik_ozet = (
    df.groupby("Departman")
    .agg(
        Toplam_Calisan=("ID", "count"),
        Ortalama_Maas=("Maas", "mean"),
        Ayrilan_Sayisi=("Durum", lambda x: np.sum(x == "Ayrildi")),
    )
    .reset_index()
)

# Çıktıları Yazdırma
print("--- TÜM ÇALIŞAN LİSTESİ VE KIDEMLERİ ---")
display(df[["AdSoyad", "Departman", "Maas", "Kidem_Yili", "Durum"]])

print("\n--- DEPARTMAN BAZLI İK ÖZETİ ---")
display(ik_ozet)
